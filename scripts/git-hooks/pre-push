#!/bin/sh
# Pre-push guard, mirrors CI:
#   1. scan_secrets.py --range over the commits being pushed
#   2. verify_run.py --mode final on every run packet touched
# Enabled via: git config core.hooksPath scripts/git-hooks
root=$(git rev-parse --show-toplevel)
verifier="$root/workspace/.agents/skills/workspace-manage/scripts/verify_run.py"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch deletion: nothing to check.
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New remote branch: diff against the merge base with main when there
        # is one, otherwise against the empty tree (full-content scan).
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null) \
            || base=$(git merge-base "$local_sha" main 2>/dev/null) \
            || base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
    else
        base=$remote_sha
    fi

    echo "== secret scan ($base..$local_sha) =="
    python3 "$root/scripts/scan_secrets.py" --range "$base..$local_sha" || fail=1

    run_dirs=$(git diff --name-only "$base...$local_sha" -- 'workspace/runs/*/*' \
        | cut -d/ -f1-3 | sort -u)
    for d in $run_dirs; do
        [ -d "$d" ] || continue
        echo "== verify $d (final) =="
        python3 "$verifier" "$d" --mode final || fail=1
    done
done

exit "$fail"
