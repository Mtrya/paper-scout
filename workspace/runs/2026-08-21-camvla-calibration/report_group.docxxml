<tr>
<td>直线</td>
<td><b>19.0 ± 14.3</b></td>
<td><b>16.8 ± 10.2</b></td>
<td>0.341</td>
<td><b>1.3e-9</b></td>
<td><b>3.2e4</b></td>
</tr>
<tr>
<td>平面</td>
<td>0.49 ± 0.08</td>
<td>2.06 ± 1.69</td>
<td>4.5e-5</td>
<td>1.2e3</td>
<td>105</td>
</tr>
<tr>
<td>体积</td>
<td>0.34 ± 0.10</td>
<td>5.75 ± 2.27</td>
<td>3.3e-5</td>
