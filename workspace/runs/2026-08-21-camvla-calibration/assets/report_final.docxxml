<tr>
<th background-color="light-gray">等效焦距偏差</th>
<th background-color="light-gray">0%</th>
<th background-color="light-gray">±2.7%</th>
<th background-color="light-gray">−5.3% / +5.8%</th>
<th background-color="light-gray">−10.2% / +12.3%</th>
</tr>
