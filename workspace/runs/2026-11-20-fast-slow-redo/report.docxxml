  <colgroup>
    <col width="300"/>
    <col width="120"/>
    <col width="120"/>
  </colgroup>
  <thead>
    <tr>
      <th background-color="light-gray"><p>回合归属（以无判官首跑为代理）</p></th>
      <th background-color="light-gray"><p>困难子集（72）</p></th>
      <th background-color="light-gray"><p>LIBERO-Pro（590）</p></th>
